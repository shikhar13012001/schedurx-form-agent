# schedurx-backend's origin — server-only (never exposed to the browser).
# next.config.ts's rewrite proxies /api/v1/public/* to this origin, which is
# what lets the browser call this app's own HTTPS origin instead of hitting
# the backend's plain-HTTP droplet directly (avoids mixed-content + CORS).
BACKEND_API_ORIGIN=http://localhost:4000

# App
NEXT_PUBLIC_APP_URL=https://schedurx.app
